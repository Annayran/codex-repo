{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ocorrência de estoque nos Portais - envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "caseType", "environment", "document", "report", "collectedAt", "evidence", "gaps"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 100},
    "caseType": {"const": "REPORTED_INSUFFICIENT_STOCK"},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["clientRef", "environmentRef", "stage"],
      "properties": {
        "clientRef": {"type": "string", "minLength": 1, "maxLength": 100},
        "environmentRef": {"type": "string", "minLength": 1, "maxLength": 100},
        "stage": {"const": "HOMOLOGATION"},
        "erpVersion": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "companyRef"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 100},
        "companyRef": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["attemptedOperation", "description"],
      "properties": {
        "attemptedOperation": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "displayedMessage": {"type": "string", "maxLength": 4000},
        "occurredAt": {"type": "string", "format": "date-time"}
      }
    },
    "collectedAt": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "source", "capturedAt", "status", "summary"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100},
          "category": {"enum": ["DOCUMENT", "ITEM", "STOCK", "CONFIGURATION", "CUSTOMIZATION", "TECHNICAL"]},
          "source": {"type": "string", "minLength": 1, "maxLength": 300},
          "capturedAt": {"type": "string", "format": "date-time"},
          "status": {"enum": ["COLLECTED", "UNAVAILABLE", "FAILED"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "gaps": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  }
}