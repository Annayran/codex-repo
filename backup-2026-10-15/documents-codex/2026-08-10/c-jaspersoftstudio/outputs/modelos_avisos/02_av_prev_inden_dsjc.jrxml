      </image>
      <textField isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="Base" positionType="Float" x="0" y="58" width="467" height="30"/>
        <textElement textAlignment="Center" verticalAlignment="Top"><font size="14" isBold="true"/></textElement>
        <textFieldExpression class="java.lang.String"><![CDATA["Aviso Prévio do Empregador para dispensa do Empregado"]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="Base" positionType="Float" x="0" y="104" width="467" height="24"/>
        <textElement textAlignment="Left" verticalAlignment="Top"><font size="11" isBold="false"/></textElement>
        <textFieldExpression class="java.lang.String"><![CDATA["Ao Sr(a): " + ($F{COLABORADOR} == null || $F{COLABORADOR}.trim().length() == 0 ? "____________________________" : $F{COLABORADOR})]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="Base" positionType="Float" x="0" y="136" width="467" height="78"/>
        <textElement textAlignment="Justified" verticalAlignment="Top"><font size="11" isBold="false"/></textElement>
        <textFieldExpression class="java.lang.String"><![CDATA["Pela presente o notificamos que a partir desta data, não mais serão utilizados os seus serviços pela nossa empresa e por isso vimos avisá-lo, nos termos e para os efeitos no disposto no Artigo 487, Item II, Cap. VI do Decreto Lei nº 5452 de 01/05/43 (CLT)."]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="Base" positionType="Float" x="0" y="224" width="467" height="78"/>
        <textElement textAlignment="Justified" verticalAlignment="Top"><font size="11" isBold="false"/></textElement>
        <textFieldExpression class="java.lang.String"><![CDATA["Aplica-se à contagem do prazo do aviso prévio a regra prevista no “caput” do Art. 132 do Código Civil de 2002, também prevista na instrução normativa SRT Nº 3 do Ministério do Trabalho e na súmula 380 do TST, excluindo-se o dia do começo e incluindo o do vencimento."]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="Base" positionType="Float" x="0" y="312" width="467" height="30"/>
        <textElement textAlignment="Justified" verticalAlignment="Top"><font size="11" isBold="false"/></textElement>
        <textFieldExpression class="java.lang.String"><![CDATA["Solicitamos a devolução da cópia deste, com seu ciente."]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="Base" positionType="Float" x="0" y="352" width="467" height="26"/>
        <textElement textAlignment="Center" verticalAlignment="Top"><font size="11" isBold="false"/></textElement>
        <textFieldExpression class="java.lang.String"><![CDATA[($F{CIDADE} == null || $F{CIDADE}.trim().length() == 0 ? "____________________________" : $F{CIDADE}) + ", " + ($F{DATA_DOCUMENTO} == null || $F{DATA_DOCUMENTO}.trim().length() == 0 ? "____________________________" : $F{DATA_DOCUMENTO})]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="Base" positionType="Float" x="0" y="386" width="467" height="44"/>
        <textElement textAlignment="Center" verticalAlignment="Top"><font size="11" isBold="false"/></textElement>
        <textFieldExpression class="java.lang.String"><![CDATA["_____________________________________________\n" + ($F{EMPRESA} == null || $F{EMPRESA}.trim().length() == 0 ? "____________________________" : $F{EMPRESA})]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="Base" positionType="Float" x="0" y="438" width="467" height="20"/>
        <textElement textAlignment="Left" verticalAlignment="Top"><font size="11" isBold="false"/></textElement>
        <textFieldExpression class="java.lang.String"><![CDATA["Ciente,"]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="Base" positionType="Float" x="0" y="466" width="467" height="76"/>
        <textElement textAlignment="Justified" verticalAlignment="Top"><font size="11" isBold="false"/></textElement>
        <textFieldExpression class="java.lang.String"><![CDATA["Estou ciente que deverei devolver: Objetos e materiais de qualquer natureza postos sob minha responsabilidade e não devolvidos no devido tempo, autorizo expressamente a EMPREGADORA a descontar de meus vencimentos."]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="Base" positionType="Float" x="0" y="552" width="467" height="58"/>
        <textElement textAlignment="Center" verticalAlignment="Top"><font size="11" isBold="false"/></textElement>
        <textFieldExpression class="java.lang.String"><![CDATA["_____________________________________________\n" + ($F{COLABORADOR} == null || $F{COLABORADOR}.trim().length() == 0 ? "____________________________" : $F{COLABORADOR}) + "\nNome do colaborador"]]></textFieldExpression>
      </textField>
    </band>
