<?xml version="1.0" encoding="UTF-8" standalone="no"?><jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bottomMargin="30" columnWidth="482" language="java" leftMargin="57" name="Formulario_Intercambio_SOU_Unimed_Uberlandia" pageHeight="842" pageWidth="595" rightMargin="56" topMargin="30" whenNoDataType="AllSectionsNoDetail" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd">

    <property name="net.sf.jasperreports.export.pdf.tagged" value="true"/>

    <style fontName="SansSerif" fontSize="8" name="Base" pdfEncoding="Cp1252" pdfFontName="Helvetica"/>
    <style fontSize="10" isBold="true" isUnderline="true" name="Secao" style="Base"/>
    <style fontSize="7" hAlign="Center" name="Numero" style="Base" vAlign="Middle">
        <box><pen lineColor="#000000" lineWidth="0.5"/></box>
    </style>
