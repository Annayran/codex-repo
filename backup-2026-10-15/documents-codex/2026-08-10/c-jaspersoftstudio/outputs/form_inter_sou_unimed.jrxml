    <style fontSize="8" name="Texto" style="Base" vAlign="Middle"/>

    <parameter class="java.lang.String" name="P_CODEMP"/>
    <parameter class="java.lang.String" name="P_CODFUNC"/>
    <parameter class="java.lang.String" name="P_RESPONSAVEL_SOLICITANTE"/>
    <parameter class="java.lang.String" name="P_FINALIDADE"/>
    <parameter class="java.lang.String" name="P_NOVA_FUNCAO"/>
    <parameter class="java.lang.String" name="P_NOVO_SETOR"/>
    <parameter class="java.lang.String" name="P_DATA_PROVAVEL_ADMISSAO"/>
    <parameter class="java.lang.String" name="P_CIDADE_ATENDIMENTO"/>

    <queryString><![CDATA[SELECT
    NVL(EMP.RAZAOSOCIALCOMPLETA, NVL(EMP.RAZAOSOCIAL, EMP.NOMEFANTASIA)) AS EMPRESA_CLIENTE,
    EMP.CGC AS CNPJ,
    PAR.RESPONSAVEL_SOLICITANTE AS RESPONSAVEL_SOLICITANTE,
    TO_CHAR(SYSDATE, 'DD/MM/YYYY') AS DATA_SOLICITACAO,
    CASE WHEN PAR.FINALIDADE IN ('A', 'ADMISSIONAL') THEN 'X' ELSE '' END AS ADMISSIONAL,
    CASE WHEN PAR.FINALIDADE IN ('P', 'PERIODICO', 'PERIÓDICO') THEN 'X' ELSE '' END AS PERIODICO,
    CASE WHEN PAR.FINALIDADE IN ('D', 'DEMISSIONAL') THEN 'X' ELSE '' END AS DEMISSIONAL,
    CASE WHEN PAR.FINALIDADE IN ('M', 'MUDANCA', 'MUDANÇA', 'MUDANCA DE RISCO', 'MUDANÇA DE RISCO') THEN 'X' ELSE '' END AS MUDANCA_RISCO,
    PAR.NOVA_FUNCAO AS NOVA_FUNCAO,
    PAR.NOVO_SETOR AS NOVO_SETOR,
    CASE WHEN PAR.FINALIDADE IN ('R', 'RETORNO', 'RETORNO AO TRABALHO') THEN 'X' ELSE '' END AS RETORNO_TRABALHO,
    FUN.NOMEFUNC AS NOME_COMPLETO,
    CAST(NULL AS VARCHAR2(4000)) AS DATA_NASCIMENTO,
    PAR.DATA_PROVAVEL_ADMISSAO AS DATA_PROVAVEL_ADMISSAO,
    CAST(NULL AS VARCHAR2(4000)) AS CPF,
    CAST(NULL AS VARCHAR2(4000)) AS CARGO,
    CAST(NULL AS VARCHAR2(4000)) AS SETOR,
    CAST(NULL AS VARCHAR2(4000)) AS NOME_MAE,
    CAST(NULL AS VARCHAR2(4000)) AS SEXO,
    CAST(NULL AS VARCHAR2(4000)) AS CELULAR_FUNCIONARIO,
    CAST(NULL AS VARCHAR2(4000)) AS EMAIL_FUNCIONARIO,
    NVL(PAR.CIDADE_ATENDIMENTO, CID.NOMECID) AS CIDADE_ATENDIMENTO
FROM (
    SELECT TO_NUMBER(TRIM($P{P_CODEMP})) AS CODEMP,
           TO_NUMBER(TRIM($P{P_CODFUNC})) AS CODFUNC,
           TRIM($P{P_RESPONSAVEL_SOLICITANTE}) AS RESPONSAVEL_SOLICITANTE,
           UPPER(TRIM($P{P_FINALIDADE})) AS FINALIDADE,
           TRIM($P{P_NOVA_FUNCAO}) AS NOVA_FUNCAO,
           TRIM($P{P_NOVO_SETOR}) AS NOVO_SETOR,
           TRIM($P{P_DATA_PROVAVEL_ADMISSAO}) AS DATA_PROVAVEL_ADMISSAO,
           TRIM($P{P_CIDADE_ATENDIMENTO}) AS CIDADE_ATENDIMENTO
    FROM DUAL
) PAR
LEFT JOIN VFPFUN FUN
       ON FUN.CODEMP = PAR.CODEMP
      AND FUN.CODFUNC = PAR.CODFUNC
LEFT JOIN TSIEMP EMP ON EMP.CODEMP = PAR.CODEMP
LEFT JOIN TSICID CID ON CID.CODCID = EMP.CODCID
ORDER BY PAR.CODEMP, PAR.CODFUNC]]></queryString>

