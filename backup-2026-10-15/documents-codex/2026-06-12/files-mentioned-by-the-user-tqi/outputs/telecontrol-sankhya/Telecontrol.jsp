var DATA=window.SANKHYA_DATA||{};var current=mainScreens[0];var selected=null;var tab='resumo';var editMode='new';function rows(s){s=s||current;return DATA[s.table]||[]}function val(r,f){return r&&r[f]!=null&&r[f]!==''?r[f]:'-'}function setText(id,t){var e=document.getElementById(id);if(e)e.textContent=t}function init(){renderModules();renderKpis();selectScreen('produtos')}function renderModules(){var html='';for(var i=0;i<mainScreens.length;i++){var s=mainScreens[i];html+='<button class="module '+(s.id===current.id?'active ':'')+(s.type==='future'?'disabled':'')+'" onclick="selectScreen(&quot;'+s.id+'&quot;)"><span class="module-icon"><i class="fa-solid '+s.icon+'"></i></span><span><strong>'+s.title+'</strong><span>'+s.table+(s.type==='future'?' - em mapeamento':'')+'</span></span><b class="module-badge">'+rows(s).length+'</b></button>'}document.getElementById('moduleList').innerHTML=html}function renderKpis(){var ps=mainScreens.filter(function(s){return s.type==='main'});var total=0,pend=0,ativos=0,rel=0;for(var i=0;i<ps.length;i++){var list=rows(ps[i]);total+=list.length;rel+=ps[i].details.length;for(var j=0;j<list.length;j++){var r=list[j];if(!r.DHINTEG||r.DHINTEG==='-')pend++;if(r.ATIVO==='S'||r.PEDFATURADO==='S'||r.PEDGARANTIA==='S')ativos++}}setText('kpiRegistros',total);setText('kpiPendentes',pend);setText('kpiAtivos',ativos);setText('kpiVinculos',rel);setText('heroHealth',pend?pend+' pendencias de integracao':'Integracoes sem pendencia aparente')}function selectScreen(id){for(var i=0;i<mainScreens.length;i++){if(mainScreens[i].id===id)current=mainScreens[i]}selected=null;tab='resumo';renderModules();setText('screenTitle',current.title);setText('screenSub',current.table+' - '+rows(current).length+' registros');document.getElementById('searchRecords').value='';renderTable();renderContext()}function filteredRows(){var q=document.getElementById('searchRecords').value.toLowerCase();return rows().filter(function(r){if(!q)return true;var vals=Object.values(r);for(var i=0;i<vals.length;i++){if(String(vals[i]).toLowerCase().indexOf(q)>=0)return true}return false})}function renderTable(){var head=document.getElementById('tableHead'),body=document.getElementById('tableBody');head.innerHTML='<tr>'+current.fields.map(function(f){return '<th>'+f+'</th>'}).join('')+'<th>Status</th></tr>';var list=filteredRows();if(current.type==='future'){body.innerHTML='<tr><td colspan="'+(current.fields.length+1)+'">Tabela prevista no cockpit. Falta mapear campos, chaves e acoes.</td></tr>';return}if(!list.length){body.innerHTML='<tr><td colspan="'+(current.fields.length+1)+'">Nenhum registro encontrado.</td></tr>';return}var html='';for(var i=0;i<list.length;i++){var r=list[i];html+='<tr onclick="selectRecord('+i+')" class="'+(selected===r?'selected':'')+'">';for(var f=0;f<current.fields.length;f++)html+='<td>'+fmt(current.fields[f],val(r,current.fields[f]))+'</td>';html+='<td>'+status(r)+'</td></tr>'}body.innerHTML=html}function selectRecord(i){selected=filteredRows()[i];tab='resumo';renderTable();renderContext()}function renderContext(){var el=document.getElementById('context');if(!selected){el.innerHTML='<div class="context-empty"><div><i class="fa-solid fa-arrow-pointer" style="font-size:30px;margin-bottom:12px"></i><p>Selecione um registro para ver resumo, detalhes e operacoes.</p></div></div>';return}el.innerHTML='<div class="context-head"><span>'+current.table+' / '+current.key+': '+val(selected,current.key)+'</span><strong>'+val(selected,current.desc)+'</strong></div><div class="tabs"><button class="tab '+(tab==='resumo'?'active':'')+'" onclick="setTab(&quot;resumo&quot;)">Resumo</button><button class="tab '+(tab==='detalhes'?'active':'')+'" onclick="setTab(&quot;detalhes&quot;)">Detalhes</button><button class="tab '+(tab==='operacoes'?'active':'')+'" onclick="setTab(&quot;operacoes&quot;)">Operacoes</button></div><div class="context-body">'+tabHtml()+'</div>'}function setTab(t){tab=t;renderContext()}function tabHtml(){if(tab==='detalhes')return detailsHtml();if(tab==='operacoes')return opsHtml();return summaryHtml()}function summaryHtml(){var fs=current.fields.concat(current.editFields.filter(function(f){return current.fields.indexOf(f)<0}));return '<div class="field-grid">'+fs.map(function(f){return '<div class="mini-field"><span>'+f+'</span><strong>'+fmt(f,val(selected,f))+'</strong></div>'}).join('')+'</div>'}function detailsHtml(){if(!current.details.length)return '<p class="muted">Esta tela ainda nao possui detalhes mapeados.</p>';var html='';for(var i=0;i<current.details.length;i++){var d=current.details[i];var list=(DATA[d.table]||[]).filter(function(r){return !d.parentField||String(r[d.childField])===String(selected[d.parentField])});var table=list.length?'<table class="mini-table"><thead><tr>'+(d.columns||[]).map(function(c){return '<th>'+c+'</th>'}).join('')+'</tr></thead><tbody>'+list.slice(0,8).map(function(r){return '<tr>'+(d.columns||[]).map(function(c){return '<td>'+fmt(c,val(r,c))+'</td>'}).join('')+'</tr>'}).join('')+'</tbody></table>':'<p>Nenhum detalhe encontrado para o registro selecionado.</p>';html+='<div class="detail-card"><h4>'+d.title+'</h4><p>'+d.table+(d.parentField?' - filtro '+d.childField+' = '+selected[d.parentField]:'')+'</p>'+table+'</div>'}return html}function opsHtml(){var actions=current.actions.map(function(a){return '<div class="op-card"><h4>'+a.label+'</h4><p>Executa rotina de integracao para o registro atual.</p><div style="margin-top:10px"><button class="btn btn-red" onclick="runAction('+a.code+')"><i class="fa-solid fa-play"></i> Executar</button></div></div>'}).join('')||'<p class="muted">Nenhuma acao de integracao mapeada.</p>';return '<div class="op-card"><h4>CRUD basico</h4><p>Inclua, edite ou remova registro da entidade atual.</p><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px"><button class="btn btn-dark" onclick="openForm(&quot;new&quot;)"><i class="fa-solid fa-plus"></i> Inserir</button><button class="btn btn-soft" onclick="openForm(&quot;edit&quot;)"><i class="fa-solid fa-pen"></i> Editar</button><button class="btn btn-soft" onclick="deleteRecord()"><i class="fa-solid fa-trash"></i> Deletar</button></div></div>'+actions}function openForm(mode){if(current.type==='future'){toast('Esta tabela ainda esta em mapeamento.');return}editMode=mode;if(mode==='edit'&&!selected){toast('Selecione um registro para editar.');return}setText('modalTitle',mode==='new'?'Inserir registro':'Editar registro');var rec=mode==='edit'?selected:{};document.getElementById('modalFields').innerHTML=current.editFields.map(function(f){return '<div class="modal-field"><label>'+f+'</label><input data-field="'+f+'" value="'+(mode==='edit'?escapeAttr(val(rec,f)):'')+'" '+(mode==='edit'&&f===current.key?'readonly':'')+'></div>'}).join('');document.getElementById('modal').classList.add('active')}function closeForm(){document.getElementById('modal').classList.remove('active')}function saveForm(){var inputs=[].slice.call(document.querySelectorAll('#modalFields input'));var localFields={};for(var i=0;i<inputs.length;i++){var inp=inputs[i];if(!(editMode==='edit'&&inp.dataset.field===current.key))localFields[inp.dataset.field]={$:inp.value}}var rowData={localFields:localFields};if(editMode==='edit'){rowData.key={};rowData.key[current.key]={$:selected[current.key]};}callCrud('CRUDServiceProvider.saveRecord',{dataSet:{rootEntity:current.table,includePresentationFields:'N',entity:{path:'',fieldset:{list:current.editFields.join(',')}},dataRow:[rowData]}},function(){toast('Registro salvo. Recarregando.');closeForm();setTimeout(function(){location.reload()},900)})}function deleteRecord(){if(!selected){toast('Selecione um registro para deletar.');return}if(!confirm('Deseja deletar este registro?'))return;callCrud('CRUDServiceProvider.removeRecord',{entity:{rootEntity:current.table,key:(function(){var k={};k[current.key]={$:selected[current.key]};return k;})()}},function(){toast('Registro removido. Recarregando.');setTimeout(function(){location.reload()},900)})}function refresh(){location.reload()}function runAction(code){toast('Acao codigo '+code+' mapeada. Falta plugar o servico de execucao de acoes do ambiente.')}function callCrud(serviceName,requestBody,onSuccess){var sid=getCookie('JSESSIONID').replace('.master','');if(!sid){toast('Sessao Sankhya nao encontrada.');return}fetch('/mge/service.sbr?serviceName='+serviceName+'&outputType=json&mgeSession='+sid,{method:'POST',headers:{'Content-Type':'application/json; charset=UTF-8'},body:JSON.stringify({serviceName:serviceName,requestBody:requestBody})}).then(function(r){return r.json()}).then(function(resp){if(resp.status==='1')onSuccess(resp);else toast('Erro no servico: '+(resp.statusMessage||'ver console'))}).catch(function(e){toast('Falha na chamada: '+e.message)})}function getCookie(name){var parts=('; '+document.cookie).split('; '+name+'=');return parts.length===2?parts.pop().split(';').shift():''}function status(r){if(r.ATIVO==='S')return '<span class="status ok">Ativo</span>';if(r.ATIVO==='N')return '<span class="status bad">Inativo</span>';if(!r.DHINTEG||r.DHINTEG==='-')return '<span class="status warn">Pendente</span>';return '<span class="status ok">Integrado</span>'}function fmt(field,value){if(value==='-')return '<span class="muted">-</span>';if(value==='S')return '<span class="status ok">Sim</span>';if(value==='N')return '<span class="status bad">Nao</span>';if(/^COD|ID$|LISTA/.test(field))return '<span class="code">'+value+'</span>';return String(value)}function escapeAttr(v){return String(v).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;')}function toast(msg){var t=document.getElementById('toast');t.textContent=msg;t.classList.add('active');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(function(){t.classList.remove('active')},4600)}init();
</script></body></html>