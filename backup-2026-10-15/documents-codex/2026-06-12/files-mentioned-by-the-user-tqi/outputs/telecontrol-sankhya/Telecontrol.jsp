var mainScreens=[{id:'produtos',title:'Produtos',table:'AD_TCLPRO',key:'CODPROD',desc:'DESCRICAO',icon:'fa-box-open',type:'main',fields:['CODPROD','REFERENCIA','DESCRICAO','CODFAMILIA','CODLINHA','ATIVO','DHINTEG'],editFields:['CODPROD','REFERENCIA','DESCRICAO','CODFAMILIA','CODLINHA','ATIVO','MARCA','VOLTAGEM'],actions:[{code:103,label:'Enviar produto'},{code:138,label:'Sincronizar produtos'}],details:[{title:'Lista Basica',table:'AD_TCLLTB',parentField:'CODPROD',childField:'CODPROD',columns:['LISTABASICA','CODPECA','QTD','POSICAO','REFPECA']},{title:'Linha',table:'AD_TCLLIN',parentField:'CODLINHA',childField:'CODLINHA',columns:['CODLINHA','NOME','ATIVO']},{title:'Familia',table:'AD_TCLFAM',parentField:'CODFAMILIA',childField:'CODFAMILIA',columns:['CODFAMILIA','DESCRICAO']}]},{id:'pecas',title:'Pecas',table:'AD_TCLPCA',key:'CODPROD',desc:'DESCRICAO',icon:'fa-screwdriver-wrench',type:'main',fields:['CODPROD','REFERENCIA','DESCRICAO','ATIVO','ESTOQUE','COD_TELECONTROL'],editFields:['CODPROD','REFERENCIA','DESCRICAO','ATIVO','ESTOQUE','UNIDADE','PRECOVEN','PRECOGAR'],actions:[{code:105,label:'Enviar pecas'},{code:137,label:'Atualizar pecas'}],details:[{title:'Usada em lista basica',table:'AD_TCLLTB',parentField:'CODPROD',childField:'CODPECA',columns:['LISTABASICA','CODPROD','QTD','POSICAO']}]},{id:'postos',title:'Postos',table:'AD_TCLPST',key:'CODPARC',desc:'CREDENCIAMENTO',icon:'fa-store',type:'main',fields:['CODPARC','POSTOID','CREDENCIAMENTO','TIPOPOSTO','PEDFATURADO','PEDGARANTIA'],editFields:['CODPARC','POSTOID','CREDENCIAMENTO','TIPOPOSTO','PEDFATURADO','PEDGARANTIA','DESCONTO','VALORKM'],actions:[{code:108,label:'Enviar posto'}],details:[]},{id:'os',title:'Ordens de Servico',table:'AD_OSTLC',key:'CODOS',desc:'Ordem de Servico',icon:'fa-clipboard-list',type:'future',fields:['CODOS','STATUS','DHINTEG'],editFields:[],actions:[],details:[{title:'Anexos da OS',table:'AD_OSANEXO'},{title:'Pecas da OS',table:'AD_OSPECA'}]},{id:'pedidos',title:'Pedidos',table:'AD_TCLPE